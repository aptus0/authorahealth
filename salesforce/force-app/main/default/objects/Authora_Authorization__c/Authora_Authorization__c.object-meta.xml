<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <deploymentStatus>Deployed</deploymentStatus>
  <description>Authora prior authorization operational reference. Clinical documents remain in Authora unless explicitly configured.</description>
  <enableActivities>true</enableActivities>
  <enableReports>true</enableReports>
  <label>Authora Authorization</label>
  <nameField><displayFormat>AUTH-{000000}</displayFormat><label>Authorization Number</label><type>AutoNumber</type></nameField>
  <pluralLabel>Authora Authorizations</pluralLabel>
  <sharingModel>ReadWrite</sharingModel>
  <validationRules>
    <fullName>Service_Date_Required_For_Submission</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Ready to Submit"), ISBLANK(Service_Date__c))</errorConditionFormula>
    <errorMessage>Service date is required before an authorization can be submitted.</errorMessage>
  </validationRules>
</CustomObject>
